{
  "name": "eslint-plugin-fold",
  "version": "0.1.0",
  "description": "A single ESLint rule, fold/breaks, that decides where the newlines go.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bikeshaving/fold.git"
  },
  "homepage": "https://github.com/bikeshaving/fold#readme",
  "bugs": {
    "url": "https://github.com/bikeshaving/fold/issues"
  },
  "author": "Brian Kim",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./index": {
      "import": "./dist/index.js"
    },
    "./index.js": {
      "import": "./dist/index.js"
    },
    "./package.json": "./dist/package.json"
  },
  "files": [
    "docs",
    "README.md",
    "LICENSE",
    "dist/"
  ],
  "scripts": {
    "test": "libuild test -p node",
    "build": "libuild build",
    "stage": "libuild stage --provenance"
  },
  "keywords": [
    "eslint",
    "formatter",
    "line-breaks"
  ],
  "license": "MIT",
  "peerDependencies": {
    "eslint": ">=9"
  },
  "devDependencies": {
    "@b9g/libuild": "^0.2.20",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.8.1",
    "prettier": "^3.9.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  },
  "module": "./dist/index.js"
}
