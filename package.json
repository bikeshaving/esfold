{
  "name": "eslint-plugin-fold",
  "version": "0.1.0",
  "description": "A single ESLint rule, fold/breaks, that decides where the newlines go.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bikeshaving/fold.git"
  },
  "homepage": "https://github.com/bikeshaving/fold#readme",
  "bugs": {
    "url": "https://github.com/bikeshaving/fold/issues"
  },
  "author": "Brian Kim",
  "type": "module",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "docs"
  ],
  "scripts": {
    "test": "libuild test -p node",
    "corpus": "node scripts/clone-corpus.js",
    "audit": "node scripts/audit.js",
    "diff": "node scripts/diff-prettier.js",
    "build": "libuild build",
    "stage": "libuild stage --provenance",
    "prepublishOnly": "echo 'ERROR: Cannot publish from root directory. Use npm run stage instead.' && exit 1"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "formatter",
    "line-breaks"
  ],
  "license": "MIT",
  "peerDependencies": {
    "eslint": ">=9"
  },
  "devDependencies": {
    "@b9g/libuild": "^0.2.20",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.8.1",
    "prettier": "^3.9.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  }
}
